<?xml version="1.0" encoding="utf-8"?>
<!-- Course-rule tick, active zone: bright urgency ring (teal by default,
     tinted amber/coral at runtime), mirrors mock `.cr-tick.is-active`. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size
        android:height="8dp"
        android:width="8dp" />
    <solid android:color="#40E0C2" />
    <stroke
        android:width="2dp"
        android:color="#80FFFFFF" />
</shape>