<?xml version="1.0" encoding="utf-8"?>
<!-- Water-glass guidance card surface, mirrors mock `.guidance-inner`. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:endColor="#08131F"
        android:startColor="#0C1C2C" />
    <stroke
        android:width="1dp"
        android:color="#1A9DB2C0" />
    <padding
        android:bottom="14dp"
        android:left="16dp"
        android:right="16dp"
        android:top="12dp" />
</shape>