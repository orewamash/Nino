<?xml version="1.0" encoding="utf-8"?><!-- Nino · Harbor Beacon HUD (ports mock/index.html guidance card, course rule, radar and console dock). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sea_deep">

    <com.nino.app.customview.AutoFitTextureView
        android:id="@+id/texture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.nino.app.customview.OverlayView
        android:id="@+id/tracking_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD: guidance card (beam + phrase + meta + course rule) and the sounding chart. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/guidance_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:background="@drawable/guidance_card_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/guidance_phrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.01"
                android:text="@string/guidance_waiting"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- The light beam: width = android:scaleX (ahead .72 / close .58 / critical .46), tinted by urgency. -->
            <View
                android:id="@+id/guidance_beam"
                android:layout_width="260dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/beam_line"
                android:backgroundTint="@color/teal"
                android:scaleX="0.72" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/guidance_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="@string/guidance_meta_idle"
                    android:textColor="@color/fog"
                    android:textSize="12sp" />

                <!-- Course rule: left / center / right zones. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/course_tick_left"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginRight="5dp"
                        android:background="@drawable/cr_tick" />

                    <View
                        android:id="@+id/course_tick_center"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginRight="5dp"
                        android:background="@drawable/cr_tick" />

                    <View
                        android:id="@+id/course_tick_right"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/cr_tick" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/guidance_ticker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/fog_faint"
                android:textSize="11sp" />

            <com.nino.app.customview.SoundingChartView
                android:id="@+id/sounding_chart"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Steel console dock: scene re-read, voice, settings. -->
    <LinearLayout
        android:id="@+id/console_dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/console_dock_bg"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/dock_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/console_btn_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/dock_scan"
            android:textAllCaps="false"
            android:textColor="@color/fog"
            android:textSize="11sp" />

        <Button
            android:id="@+id/dock_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="@drawable/console_btn_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/dock_voice"
            android:textAllCaps="false"
            android:textColor="@color/fog"
            android:textSize="11sp" />

        <Button
            android:id="@+id/dock_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="@drawable/console_btn_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/dock_settings"
            android:textAllCaps="false"
            android:textColor="@color/fog"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>