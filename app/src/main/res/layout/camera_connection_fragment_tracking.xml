<?xml version="1.0" encoding="utf-8"?><!-- Nino -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.nino.app.customview.AutoFitTextureView
        android:id="@+id/texture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.nino.app.customview.OverlayView
        android:id="@+id/tracking_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Mirrors the latest spoken guidance so sighted examiners can verify the
         on-screen state matches the voice output during a demo. -->
    <TextView
        android:id="@+id/guidance_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/guidance_banner_bg"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:text="@string/guidance_waiting"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

</FrameLayout>
