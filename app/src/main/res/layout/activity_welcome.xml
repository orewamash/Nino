<?xml version="1.0" encoding="utf-8"?><!-- Nino · Welcome / guidelines (Harbor Beacon). Read aloud, then auto-starts the camera. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sea_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="28dp"
        android:paddingRight="20dp"
        android:paddingBottom="28dp">

        <!-- Beacon mark: a wide glow line, echoing the guidance beam. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/beam_line"
            android:backgroundTint="@color/teal"
            android:layout_gravity="center_horizontal"
            android:maxWidth="220dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/welcome_title"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:text="@string/welcome_tagline"
            android:textColor="@color/fog_faint"
            android:textSize="11sp" />

        <!-- About card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/guidance_card_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="@string/welcome_heading"
                android:textColor="@color/teal"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:text="@string/welcome_about"
                android:textColor="@color/fog"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Guidelines card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/guidance_card_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="@string/welcome_guidelines_heading"
                android:textColor="@color/teal"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="@string/welcome_guideline_1"
                android:textColor="@color/fog"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="@string/welcome_guideline_2"
                android:textColor="@color/fog"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="@string/welcome_guideline_3"
                android:textColor="@color/fog"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="@string/welcome_guideline_4"
                android:textColor="@color/fog"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Begin button: steel tab, teal bevel, starts immediately without waiting for TTS. -->
        <Button
            android:id="@+id/welcome_begin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/console_btn_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.22"
            android:minHeight="58dp"
            android:text="@string/welcome_begin"
            android:textAllCaps="false"
            android:textColor="@color/teal"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/welcome_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:text="@string/welcome_listening"
            android:textColor="@color/fog_faint"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>